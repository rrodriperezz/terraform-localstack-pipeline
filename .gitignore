# Terraform state: never committed. It holds resolved values for every resource
# and in a real backend it would be sensitive information.
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl
crash.log
crash.*.log

# Artifact that archive_file generates on every apply.
terraform/.build/
*.zip

# The repo's tfvars are committed on purpose (they hold no secrets).
# Anything else stays out.
*.auto.tfvars
terraform/*.tfvars
!terraform/environments/*.tfvars

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Markdown working notes stay out of the repository; the README is the
# exception.
*.md
!README.md
importante.txt

# Operating system and editors
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
